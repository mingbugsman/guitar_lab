# Copy to .env.local and fill in. Never commit .env.local.
# Local dev: run `npx supabase start` then `npx supabase status` to get these values.

# Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the app (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secret key. NOT used by the app in Phase 1; keep it out of NEXT_PUBLIC_*.
# SUPABASE_SECRET_KEY=
